# =============================================================================
# A7 Group website — environment variables
# Copy to .env (local) or /opt/a7-website/.env.production (server). NEVER commit
# the filled-in file. Integration credentials (Property Finder, Bayut, Bitrix24)
# are NOT env vars — they are entered in the admin panel (Settings > Integrations)
# and stored encrypted in the database.
# =============================================================================

# Node environment: development | production
NODE_ENV=production

# -----------------------------------------------------------------------------
# Database — PostgreSQL
# On the VPS this points at the dedicated a7-website Postgres container
# (127.0.0.1:5440). Must include ?schema=public.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://a7_website:CHANGE_ME@127.0.0.1:5440/a7_website?schema=public"

# -----------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# AUTH_SECRET: generate with `openssl rand -base64 32`. Used to sign sessions.
# AUTH_URL: the site's canonical origin (https://a7grouprealestate.com in prod).
# AUTH_TRUST_HOST: set true when running behind the nginx reverse proxy.
# -----------------------------------------------------------------------------
AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
AUTH_URL="https://a7grouprealestate.com"
AUTH_TRUST_HOST=true

# -----------------------------------------------------------------------------
# Encryption key for integration secrets at rest (AES-256-GCM).
# Exactly 32 bytes, base64-encoded: `openssl rand -base64 32`.
# Rotating this key invalidates all stored integration secrets (re-enter them).
# -----------------------------------------------------------------------------
APP_ENCRYPTION_KEY="CHANGE_ME_generate_with_openssl_rand_base64_32"

# -----------------------------------------------------------------------------
# Media uploads
# Absolute directory on disk where uploaded images/video/PDFs are stored.
# Production: /opt/a7-website-data/uploads (served by nginx `location /uploads/`).
# -----------------------------------------------------------------------------
UPLOADS_DIR="/opt/a7-website-data/uploads"

# -----------------------------------------------------------------------------
# First owner account — created by `npm run db:seed` (idempotent).
# The password is hashed with argon2 on seed; it is never stored in plaintext.
# Change OWNER_PASSWORD before seeding, then rotate it from the admin UI.
# -----------------------------------------------------------------------------
OWNER_EMAIL="owner@a7group.com"
OWNER_PASSWORD="CHANGE_ME_strong_password"
OWNER_NAME="A7 Owner"

# -----------------------------------------------------------------------------
# SMTP (optional fallback for transactional email / lead notifications).
# SMTP is also configurable in admin Settings in a later phase; these env vars
# act as the default/fallback.
# -----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="A7 Group <info@a7group.com>"
